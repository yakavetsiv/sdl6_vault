filters:
  or:
    - type == "literature-note"
    - type == "paper-note"
properties:
  title:
    displayName: Title
  tags:
    displayName: Tags
  date:
    displayName: Date
views:
  - type: table
    name: All Papers
    groupBy:
      property: date
      direction: DESC
    order:
      - title
      - tags
      - date
  - type: cards
    name: Card View
    order:
      - title
      - tags
      - date
